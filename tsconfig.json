{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": true,
		"strict": true,
		"allowJs": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"types": ["node"]
	},
	"include": [
		"plugins/**/*.js",
		"plugins/**/*.ts",
		".claude/skills/**/*.js",
		".claude/skills/**/*.ts",
		"test/**/*.ts"
	]
}
